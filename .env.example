# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tngo
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=admin@local.test
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tngo
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5432/tngo_test
CORS_ORIGINS=http://localhost:3000
API_PREFIX=/api

# Planning defaults
DEFAULT_MAX_WAIT_MINUTES=20
DEFAULT_MAX_INVEHICLE_MINUTES=60
DEFAULT_MAX_TOTAL_MINUTES=90
DEFAULT_WALK_SPEED_MPS=1.4
DEFAULT_TRANSFER_LIMIT=1
SCORE_WEIGHT_TOTAL_MINUTES=1.0
SCORE_WEIGHT_WAIT_MINUTES=0.5
SCORE_WEIGHT_WALK_METERS=0.001

# Routing / OSRM (optional)
ENABLE_OSRM=false
OSRM_URL=http://localhost:5000
OSRM_PORT=5000
COMPOSE_PROFILES=

# On-demand loader defaults
DEFAULT_DEPOT_NAME=Main Depot
DEFAULT_DEPOT_LAT=35.1495
DEFAULT_DEPOT_LNG=-90.0490
DEFAULT_VEHICLE_COUNT=10
DEFAULT_VEHICLE_CAPACITY=4
DEFAULT_SERVICE_START=06:00
DEFAULT_SERVICE_END=22:00
DEFAULT_SERVICE_DAYS=mon,tue,wed,thu,fri,sat
DEFAULT_SERVICE_ZONE_METERS=3000
DEFAULT_ONDEMAND_SPEED_KMPH=30
